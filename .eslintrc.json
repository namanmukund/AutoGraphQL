{
  "extends": "airbnb-base",
  "parser": "babel-eslint",
  "parserOptions": {
    "ecmaVersion": 8
  },
  "env": {
    "mocha" : true
  },
  "rules": {
    "linebreak-style": 0,
    "semi": 2,
    "no-unused-vars": 2,
    "import/prefer-default-export": 0,
    "arrow-body-style": 2,
    "no-console": 2,
    "no-debugger": 2,
    "import/named": 0,
    "import/no-cycle": 0,
    "import/no-named-as-default": 0,
    "import/no-named-as-default-member": 0,
    "max-len": 0,
    "prefer-destructuring": 0,
    "no-restricted-globals": 0,
    "no-undef": 0,
    "no-underscore-dangle": 0,
    "no-useless-catch": 0,
    "no-buffer-constructor": 0,
    "no-restricted-properties": [2, {
        "object": "describe",
        "property": "only"
    }, {
        "object": "describe",
        "property": "skip"
    }]
  }
}

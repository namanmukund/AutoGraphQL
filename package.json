{
  "name": "tekieserver",
  "version": "1.6.1-11",
  "description": "",
  "main": "build/main.js",
  "scripts": {
    "check-coverage": "nyc check-coverage --statements 84.22 --lines 84.61 --functions 80.24 --branches 59.71",
    "build:cloudProd": "./node_modules/.bin/webpack --config webpack/webpack.cloudProd.js",
    "start:core": "better-npm-run start:core",
    "start:core:debug": "better-npm-run start:core:debug",
    "start:cloudBuild": "better-npm-run start:cloudBuild",
    "start": "better-npm-run start:core",
    "start-debug": "better-npm-run start-debug",
    "test": "better-npm-run test:core",
    "test:core": "better-npm-run test:core",
    "lintfix": "eslint --fix --ignore-path .gitignore --ignore-pattern \"!**/.*\" .",
    "lint": "eslint --ignore-path .gitignore --ignore-pattern \"!**/.*\" .",
    "updateUsageCountInFile": "babel-node scripts/usageCount/updateUsageCountInFile BABEL_ENV=ssr"
  },
  "betterScripts": {
    "start:cloudBuild": {
      "command": "node ./build/mainCloud.js",
      "env": {
        "APPLICATION": "core",
        "NODE_ENV": "development",
        "PORT": 3000
      }
    },
    "test:core": {
      "command": "nyc --clean=false --reporter=text --reporter=json --reporter=text-summary --report-dir=./coverage-core mocha  ./test --timeout 4000 --recursive --compilers js:babel-core/register --require babel-polyfill",
      "env": {
        "APPLICATION": "core",
        "NODE_ENV": "test",
        "PORT": 3000
      }
    },
    "test:core:debug": {
      "command": "nyc --reporter=text mocha  ./test --timeout 4000 --recursive --compilers js:babel-core/register --require babel-polyfill",
      "env": {
        "APPLICATION": "core",
        "NODE_ENV": "test",
        "PORT": 3000,
        "DEBUG": true
      }
    },
    "start:core": {
      "command": "nodemon src/serverCloud.js --exec babel-node",
      "env": {
        "APPLICATION": "core"
      }
    },
    "start-debug": {
      "command": "babel-node --inspect --debug-brk src/serverCloud.js",
      "env": {
        "APPLICATION": "core",
        "NODE_ENV": "development",
        "PORT": 3000,
        "DATABASE_HOST": "localhost",
        "DATABASE_PORT": "27017"
      }
    },
    "start:core:debug": {
      "command": "babel-node --inspect --debug-brk src/serverCloud.js",
      "env": {
        "APPLICATION": "core",
        "NODE_ENV": "development",
        "PORT": 3000,
        "DATABASE_HOST": "localhost",
        "DATABASE_PORT": "27017"
      }
    }
  },

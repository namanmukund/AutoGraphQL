{
  "name": "tekieserver",
  "version": "1.6.1-11",
  "description": "",
  "main": "build/main.js",
  "scripts": {
    "check-coverage": "nyc check-coverage --statements 84.22 --lines 84.61 --functions 80.24 --branches 59.71",
    "build:cloudProd": "./node_modules/.bin/webpack --config webpack/webpack.cloudProd.js",
    "start:core": "better-npm-run start:core",
    "start:core:debug": "better-npm-run start:core:debug",
    "start:cloudBuild": "better-npm-run start:cloudBuild",
    "start": "better-npm-run start:core",
    "start-debug": "better-npm-run start-debug",
    "test": "better-npm-run test:core",
    "test:core": "better-npm-run test:core",
    "lintfix": "eslint --fix --ignore-path .gitignore --ignore-pattern \"!**/.*\" .",
    "lint": "eslint --ignore-path .gitignore --ignore-pattern \"!**/.*\" .",
    "updateUsageCountInFile": "babel-node scripts/usageCount/updateUsageCountInFile BABEL_ENV=ssr"
  },
  "betterScripts": {
    "start:cloudBuild": {
      "command": "node ./build/mainCloud.js",
      "env": {
        "APPLICATION": "core",
        "NODE_ENV": "development",
        "PORT": 3000
      }
    },
    "test:core": {
      "command": "nyc --clean=false --reporter=text --reporter=json --reporter=text-summary --report-dir=./coverage-core mocha  ./test --timeout 4000 --recursive --compilers js:babel-core/register --require @babel/polyfill",
      "env": {
        "APPLICATION": "core",
        "NODE_ENV": "test",
        "PORT": 3000
      }
    },
    "test:core:debug": {
      "command": "nyc --reporter=text mocha  ./test --timeout 4000 --recursive --compilers js:babel-core/register --require @babel/polyfill",
      "env": {
        "APPLICATION": "core",
        "NODE_ENV": "test",
        "PORT": 3000,
        "DEBUG": true
      }
    },
    "start:core": {
      "command": "nodemon src/serverCloud.js --exec babel-node",
      "env": {
        "APPLICATION": "core"
      }
    },
    "start-debug": {
      "command": "babel-node --inspect --debug-brk src/serverCloud.js",
      "env": {
        "APPLICATION": "core",
        "NODE_ENV": "development",
        "PORT": 3000,
        "DATABASE_HOST": "localhost",
        "DATABASE_PORT": "27017"
      }
    },
    "start:core:debug": {
      "command": "babel-node --inspect --debug-brk src/serverCloud.js",
      "env": {
        "APPLICATION": "core",
        "NODE_ENV": "development",
        "PORT": 3000,
        "DATABASE_HOST": "localhost",
        "DATABASE_PORT": "27017"
      }
    }
  },
  "dependencies": {
    "@sendgrid/mail": "^6.4.0",
    "apollo-errors": "^1.9.0",
    "apollo-fetch": "^0.7.0",
    "aws-sdk": "^2.555.0",
    "base-64": "^0.1.0",
    "bcrypt": "^3.0.6",
    "better-npm-run": "^0.1.1",
    "body-parser": "^1.19.0",
    "copy-webpack-plugin": "^5.0.4",
    "cors": "^2.8.5",
    "cuid": "^2.1.6",
    "express": "^4.17.1",
    "express-graphql": "^0.9.0",
    "fetch-graphql-schema": "^0.2.1",
    "fetch-retry": "^2.2.3",
    "firebase-admin": "^8.6.1",
    "formidable": "^1.2.1",
    "google-auth-library": "^5.5.1",
    "graphql": "^14.5.8",
    "graphql-server-express": "^1.4.1",
    "graphql-subscriptions": "^1.1.0",
    "graphql-tools": "^4.0.5",
    "imagemagick": "^0.1.3",
    "jsonwebtoken": "^8.5.1",
    "lodash": "^4.17.15",
    "mkdirp": "^0.5.1",
    "moment": "^2.24.0",
    "mongodb": "^3.3.3",
    "mongoose": "^5.7.6",
    "object-path": "^0.11.4",
    "path": "^0.12.7",
    "phone": "^2.4.1",
    "pluralize": "^8.0.0",
    "pretty-error": "^2.1.1",
    "raven": "^2.6.4",
    "subscriptions-transport-ws": "^0.9.16",
    "twilio": "^3.36.0",
    "validator": "^11.1.0",
    "@babel/polyfill": "^7.0.0",
    "serverless-http": "^2.3.0"
  },
  "devDependencies": {

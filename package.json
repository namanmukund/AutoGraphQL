{
  "name": "autographql",
  "version": "1.0.0",
  "description": "Schema-First, AST-Driven Auto-Generated GraphQL Backend Engine",
  "main": "build/main.js",
  "scripts": {
    "dev": "cross-env APPLICATION=core nodemon src/serverCloud.js --exec babel-node",
    "start": "cross-env APPLICATION=core nodemon src/serverCloud.js --exec babel-node",
    "start:prod": "cross-env APPLICATION=core node ./build/mainCloud.js",
    "build": "webpack --config webpack/webpack.cloudProd.js",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:logs": "docker-compose logs -f",
    "syncDBIndexes": "cross-env BABEL_ENV=ssr babel-node scripts/syncDBIndexes",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "cross-env APPLICATION=core NODE_ENV=test PORT=3000 mocha ./test --timeout 5000 --recursive --require @babel/register"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@sendgrid/mail": "^7.7.0",
    "@sentry/node": "^7.108.0",
    "@sentry/tracing": "^7.108.0",
    "apollo-errors": "^1.9.0",
    "apollo-server-cache-redis": "^3.3.1",
    "apollo-server-core": "^3.13.0",
    "apollo-server-express": "^3.13.0",
    "apollo-server-plugin-response-cache": "^3.8.2",
    "aws-cloudfront-sign": "^2.2.1",
    "aws-sdk": "^2.1585.0",
    "base-64": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "cuid": "^2.1.8",
    "dataloader": "^2.2.2",
    "date-fns": "^2.30.0",
    "express": "^4.19.2",
    "formidable": "^2.1.2",
    "google-auth-library": "^8.9.0",
    "google-libphonenumber": "^3.2.34",
    "googleapis": "^108.0.0",
    "graphql": "^15.8.0",
    "graphql-redis-subscriptions": "^2.6.0",
    "graphql-subscriptions": "^1.2.1",
    "graphql-tools": "^4.0.8",
    "graphql-ws": "^5.16.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "jssha": "^3.3.1",

    "imagemagick": "^0.1.3",
    "jsonwebtoken": "^8.5.1",
    "jssha": "^3.1.0",
    "lodash": "^4.17.15",
    "mkdirp": "^1.0.3",
    "moment": "^2.24.0",
    "mongodb": "^3.5.5",
    "mongoose": "^5.9.7",
    "node-fetch": "^2.6.1",
    "node-schedule": "^1.3.2",
    "object-path": "^0.11.4",
    "path": "^0.12.7",
    "pdf-lib": "^1.16.0",
    "phone": "^2.4.8",
    "pluralize": "^8.0.0",
    "pretty-error": "^2.1.1",

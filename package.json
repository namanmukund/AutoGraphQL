    "@babel/plugin-syntax-import-meta": "^7.10.4",
    "@babel/plugin-transform-regenerator": "^7.24.1",
    "@babel/plugin-transform-runtime": "^7.24.3",
    "@babel/preset-env": "^7.24.4",
    "@babel/register": "^7.23.7",
    "@babel/runtime": "^7.24.4",
    "eslint": "^8.57.0",

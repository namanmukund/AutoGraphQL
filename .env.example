# ==============================================================================
# AutoGraphQL - Environment Configuration Template
# Copy this file to .env to configure your local or production environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
APPLICATION=core
ENABLE_GRAPHQL_INTROSPECTION=true
ENABLE_APOLLO_PUBSUB=true
TZ=Asia/Kolkata

# ------------------------------------------------------------------------------
# 2. Security & JWT Authentication
# (Generate strong, unique secrets in production environments)
# ------------------------------------------------------------------------------
SECRET=development-jwt-secret-key-replace-in-production
FORGOT_PASSWORD_SECRET=development-forgot-password-secret
LINK_TOKEN_SECRET=development-link-token-secret

# ------------------------------------------------------------------------------
# 3. Primary Database (MongoDB)
# Defaults correspond to docker-compose.yml configuration
# ------------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=27017
DATABASE_NAME=autographql_dev
MONGODB_URI=mongodb://localhost:27017/autographql_dev

# ------------------------------------------------------------------------------
# 4. Relational / Analytics Database (PostgreSQL)
# Defaults correspond to docker-compose.yml configuration
# ------------------------------------------------------------------------------
PG_DATABASE_HOST=localhost
PG_DATABASE_PORT=5432
PG_DATABASE_NAME=autographql_dev
PG_DATABASE_USERNAME=postgres
PG_DATABASE_PASSWORD=postgrespassword
PG_DATABASE_DIALECT=postgres
PG_DATABASE_LOGGING=false
FORCE_PG_ALTER=false

# ------------------------------------------------------------------------------
# 5. Cache & Real-Time PubSub (Redis)
# Defaults correspond to docker-compose.yml configuration
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_SECRET=
ENABLE_REDIS_CACHE=false

# ------------------------------------------------------------------------------
# 6. File Upload & Storage (AWS S3 & CloudFront CDN) - Optional
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=autographql-storage
CLOUDFRONT_URI=
CLOUDFRONT_KEYPAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
FILE_BASE_URL=

# ------------------------------------------------------------------------------
# 7. Communications (SendGrid Email & Twilio SMS) - Optional
# ------------------------------------------------------------------------------
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SENDER_ID=

# ------------------------------------------------------------------------------
# 8. Google Cloud / Firebase - Optional
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 9. Application Performance Monitoring (APM & Logging) - Optional
# ------------------------------------------------------------------------------
SENTRY_DSN=
LOG_DIR=./logs
WINSTON_SERVICE_NAME=core
